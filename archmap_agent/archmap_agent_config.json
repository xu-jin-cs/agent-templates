{
  "name": "archmap_agent",
  "type": "architecture_mapping",
  "version": "1.0.0",
  "identity": {
    "role": "全量/增量代码架构分析专用 Agent",
    "purpose": "扫描项目目录、解析模块边界、生成基线或基于 Diff 做增量影响面分析",
    "downstream": ["pm", "frontend", "backend", "test", "rag_kb"]
  },
  "input_schema": {
    "project_path": {
      "type": "string",
      "required": true,
      "description": "项目根目录绝对路径"
    },
    "mode": {
      "type": "enum",
      "required": true,
      "options": ["baseline", "incremental"],
      "description": "baseline=基线全量测绘, incremental=增量Diff测绘"
    },
    "diff_doc": {
      "type": "string",
      "required": {
        "type": "conditional",
        "when": {
          "field": "mode",
          "operator": "equals",
          "value": "incremental"
        }
      },
      "description": "变更 Diff 文档路径或内容"
    },
    "requirement_text": {
      "type": "string",
      "required": false,
      "description": "需求文本，增量分析时用于定位相关模块"
    },
    "output_dir": {
      "type": "string",
      "required": false,
      "default": "{project_path}/archmap/",
      "description": "输出目录，默认落在项目根下 archmap/"
    }
  },
  "rules": {
    "output_location": "输出目录直接落在 {project_path}/archmap/，不嵌套隐藏目录或项目名子目录",
    "baseline_behavior": "基线模式首次完整扫描项目代码，生成全套架构资产",
    "incremental_behavior": "增量模式仅读取变更 Diff 文档，不全局扫描代码，基于已有资产局部更新",
    "no_snapshot": "禁止引入快照、回滚、增量日志、版本恢复等非业务概念",
    "filter_policy": "文件过滤必须覆盖黑名单、扩展名、大小、相关性截断、中文词映射",
    "edit_safety": "编辑已有文件前必须精确读取目标块，避免 old_string 不匹配",
    "task_sync": "任何工具调用完成后必须先 TaskUpdate 再下一步",
    "dependency_check": "增量模式下若 full_index.json 缺失必须报错并要求先执行 baseline"
  },
  "capabilities": [
    "全量扫描项目源码、配置、依赖文件",
    "解析模块边界与层级关系",
    "提取 API 接口、参数、返回值、调用方",
    "提取数据表、字段、索引、缓存结构",
    "构建模块间/文件间依赖矩阵",
    "生成架构图、数据链路图、时序图文本描述",
    "计算文件与模块内容哈希",
    "生成模块/API/存储资产的向量缓存",
    "基于 Diff 定位受影响范围并输出 precise_analysis",
    "校验输出资产完整性与粒度一致性"
  ],
  "workflow_steps": [
    {
      "id": "S01",
      "mode": ["baseline", "incremental"],
      "action": "输入校验与目录准备",
      "input": ["project_path", "mode", "diff_doc", "output_dir"],
      "output": []
    },
    {
      "id": "S02",
      "mode": ["baseline", "incremental"],
      "action": "根据 mode 进入基线或增量分支",
      "input": ["mode"],
      "output": []
    },
    {
      "id": "S03",
      "mode": ["baseline"],
      "action": "全量文件扫描",
      "input": ["project_path"],
      "output": ["full_index.json"]
    },
    {
      "id": "S04",
      "mode": ["baseline"],
      "action": "模块解析",
      "input": ["full_index.json"],
      "output": ["05_模块资产清单.md"]
    },
    {
      "id": "S05",
      "mode": ["baseline"],
      "action": "API 提取",
      "input": ["full_index.json", "05_模块资产清单.md"],
      "output": ["06_API资产清单.md"]
    },
    {
      "id": "S06",
      "mode": ["baseline"],
      "action": "存储资产提取",
      "input": ["full_index.json", "05_模块资产清单.md"],
      "output": ["07_存储资产清单.md"]
    },
    {
      "id": "S07",
      "mode": ["baseline"],
      "action": "依赖关系解析",
      "input": ["full_index.json", "05_模块资产清单.md"],
      "output": ["08_依赖矩阵.md"]
    },
    {
      "id": "S08",
      "mode": ["baseline"],
      "action": "架构图生成",
      "input": ["05_模块资产清单.md", "08_依赖矩阵.md"],
      "output": ["02_架构图.md"]
    },
    {
      "id": "S09",
      "mode": ["baseline"],
      "action": "数据链路图生成",
      "input": ["06_API资产清单.md", "07_存储资产清单.md", "08_依赖矩阵.md"],
      "output": ["03_数据链路图.md"]
    },
    {
      "id": "S10",
      "mode": ["baseline"],
      "action": "时序图生成",
      "input": ["06_API资产清单.md", "08_依赖矩阵.md"],
      "output": ["04_时序图.md"]
    },
    {
      "id": "S11",
      "mode": ["baseline"],
      "action": "模块哈希计算",
      "input": ["full_index.json"],
      "output": ["module_hashes.json"]
    },
    {
      "id": "S12",
      "mode": ["baseline"],
      "action": "向量缓存生成",
      "input": ["05_模块资产清单.md", "06_API资产清单.md", "07_存储资产清单.md"],
      "output": ["vector_cache.json"]
    },
    {
      "id": "S13",
      "mode": ["baseline"],
      "action": "粒度校验",
      "input": ["全部已生成 Markdown 与 JSON"],
      "output": ["09_粒度校验报告.md"]
    },
    {
      "id": "S14",
      "mode": ["baseline"],
      "action": "执行摘要生成",
      "input": ["全部已生成 Markdown 与 JSON"],
      "output": ["01_执行摘要.md"]
    },
    {
      "id": "I03",
      "mode": ["incremental"],
      "action": "读取并解析 Diff 文档",
      "input": ["diff_doc", "requirement_text"],
      "output": []
    },
    {
      "id": "I04",
      "mode": ["incremental"],
      "action": "加载已有资产",
      "input": ["01_执行摘要.md", "05_模块资产清单.md", "06_API资产清单.md", "07_存储资产清单.md", "08_依赖矩阵.md", "module_hashes.json", "vector_cache.json"],
      "output": []
    },
    {
      "id": "I05",
      "mode": ["incremental"],
      "action": "定位受影响范围",
      "input": ["Diff 解析结果", "已有资产"],
      "output": ["precise_analysis.json"]
    },
    {
      "id": "I06",
      "mode": ["incremental"],
      "action": "更新模块资产",
      "input": ["precise_analysis.json", "05_模块资产清单.md"],
      "output": ["05_模块资产清单.md"]
    },
    {
      "id": "I07",
      "mode": ["incremental"],
      "action": "更新 API 资产",
      "input": ["precise_analysis.json", "06_API资产清单.md"],
      "output": ["06_API资产清单.md"]
    },
    {
      "id": "I08",
      "mode": ["incremental"],
      "action": "更新存储资产",
      "input": ["precise_analysis.json", "07_存储资产清单.md"],
      "output": ["07_存储资产清单.md"]
    },
    {
      "id": "I09",
      "mode": ["incremental"],
      "action": "更新依赖矩阵",
      "input": ["precise_analysis.json", "08_依赖矩阵.md", "05_模块资产清单.md"],
      "output": ["08_依赖矩阵.md"]
    },
    {
      "id": "I10",
      "mode": ["incremental"],
      "action": "重新生成架构图",
      "input": ["05_模块资产清单.md", "08_依赖矩阵.md"],
      "output": ["02_架构图.md"],
      "trigger": {
        "type": "conditional",
        "condition": "precise_analysis.json 中 affected_modules 非空 或 affected_dependencies 非空"
      }
    },
    {
      "id": "I11",
      "mode": ["incremental"],
      "action": "重新生成数据链路图",
      "input": ["06_API资产清单.md", "07_存储资产清单.md", "08_依赖矩阵.md"],
      "output": ["03_数据链路图.md"],
      "trigger": {
        "type": "conditional",
        "condition": "precise_analysis.json 中 affected_apis 非空 或 affected_storage 非空"
      }
    },
    {
      "id": "I12",
      "mode": ["incremental"],
      "action": "重新生成时序图",
      "input": ["06_API资产清单.md", "08_依赖矩阵.md"],
      "output": ["04_时序图.md"],
      "trigger": {
        "type": "conditional",
        "condition": "precise_analysis.json 中 affected_apis 非空 且涉及核心调用链变化"
      }
    },
    {
      "id": "I13",
      "mode": ["incremental"],
      "action": "更新模块哈希",
      "input": ["module_hashes.json", "diff_doc"],
      "output": ["module_hashes.json"],
      "trigger": {
        "type": "incremental",
        "scope": "diff_doc 中新增、修改、删除的文件"
      }
    },
    {
      "id": "I14",
      "mode": ["incremental"],
      "action": "更新向量缓存",
      "input": ["vector_cache.json", "05_模块资产清单.md", "06_API资产清单.md", "07_存储资产清单.md"],
      "output": ["vector_cache.json"],
      "trigger": {
        "type": "incremental",
        "scope": "05/06/07_资产清单中新增或修改的条目"
      }
    },
    {
      "id": "I15",
      "mode": ["incremental"],
      "action": "重新校验",
      "input": ["全部已更新 Markdown 与 JSON"],
      "output": ["09_粒度校验报告.md"]
    },
    {
      "id": "I16",
      "mode": ["incremental"],
      "action": "更新执行摘要",
      "input": ["全部已更新 Markdown 与 JSON"],
      "output": ["01_执行摘要.md"]
    }
  ],
  "output_spec": {
    "01_执行摘要.md": {
      "source": "全部已生成资产文件",
      "content": ["测绘模式", "输入参数", "统计信息", "输出文件清单", "变更摘要"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["pm", "test_supervisor", "acceptance_manager"]
    },
    "02_架构图.md": {
      "source": "05_模块资产清单.md, 08_依赖矩阵.md",
      "content": ["模块分层拓扑", "组件关系", "边界划分", "文本/Mermaid 描述"],
      "baseline": "generate",
      "incremental": "conditional_regenerate",
      "incremental_condition": "precise_analysis.json 中 affected_modules 非空 或 affected_dependencies 非空",
      "consumers": ["pm", "frontend", "backend", "ui_designer"]
    },
    "03_数据链路图.md": {
      "source": "06_API资产清单.md, 07_存储资产清单.md, 08_依赖矩阵.md",
      "content": ["请求入口", "下游服务", "数据库", "缓存", "外部接口", "数据流向"],
      "baseline": "generate",
      "incremental": "conditional_regenerate",
      "incremental_condition": "precise_analysis.json 中 affected_apis 非空 或 affected_storage 非空",
      "consumers": ["backend", "test", "data_engineer"]
    },
    "04_时序图.md": {
      "source": "06_API资产清单.md, 08_依赖矩阵.md",
      "content": ["核心操作", "模块交互", "调用顺序", "文本/Mermaid 时序图"],
      "baseline": "generate",
      "incremental": "conditional_regenerate",
      "incremental_condition": "precise_analysis.json 中 affected_apis 非空 且涉及核心调用链变化",
      "consumers": ["backend", "test", "pm"]
    },
    "05_模块资产清单.md": {
      "source": "full_index.json",
      "content": ["模块名称", "职责", "入口文件", "导出内容", "层级", "命名空间"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["02_架构图.md", "03_数据链路图.md", "04_时序图.md", "08_依赖矩阵.md", "precise_analysis.json"]
    },
    "06_API资产清单.md": {
      "source": "full_index.json, 05_模块资产清单.md",
      "content": ["接口方法", "路径", "参数", "返回值", "所属模块", "调用方"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["03_数据链路图.md", "04_时序图.md", "08_依赖矩阵.md", "precise_analysis.json"]
    },
    "07_存储资产清单.md": {
      "source": "full_index.json, 05_模块资产清单.md",
      "content": ["表名", "字段", "索引", "关联关系", "缓存 key 结构", "存储类型"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["03_数据链路图.md", "08_依赖矩阵.md", "precise_analysis.json"]
    },
    "08_依赖矩阵.md": {
      "source": "full_index.json, 05_模块资产清单.md",
      "content": ["模块间调用关系", "文件间调用关系", "依赖方向", "耦合度"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["02_架构图.md", "03_数据链路图.md", "04_时序图.md", "09_粒度校验报告.md"]
    },
    "09_粒度校验报告.md": {
      "source": "全部已生成资产文件",
      "content": ["必填字段检查", "数量一致性", "依赖矩阵覆盖度", "问题清单"],
      "baseline": "generate",
      "incremental": "regenerate",
      "consumers": ["pm", "test_supervisor", "acceptance_manager"]
    },
    "full_index.json": {
      "source": "project_path 全量扫描",
      "content": ["文件路径", "扩展名", "大小", "修改时间", "哈希"],
      "baseline": "generate",
      "incremental": "reuse",
      "consumers": ["基线步骤 S03-S07", "增量步骤 I04"]
    },
    "module_hashes.json": {
      "source": "full_index.json",
      "content": ["文件路径", "内容哈希", "模块聚合哈希"],
      "baseline": "generate",
      "incremental": "incremental_update",
      "incremental_scope": "diff_doc 中新增、修改、删除的文件",
      "consumers": ["增量模式比对步骤", "外部同步工具"]
    },
    "precise_analysis.json": {
      "source": "diff_doc, requirement_text, 已有资产",
      "content": ["受影响模块", "受影响 API", "受影响数据表", "受影响前端资源", "影响等级"],
      "baseline": "skip",
      "incremental": "generate",
      "consumers": ["pm", "frontend", "backend", "test", "shard_mother_child_agent"]
    },
    "vector_cache.json": {
      "source": "05_模块资产清单.md, 06_API资产清单.md, 07_存储资产清单.md",
      "content": ["文本切片", "embedding 向量", "id", "元数据"],
      "baseline": "generate",
      "incremental": "incremental_update",
      "incremental_scope": "05/06/07_资产清单中新增或修改的条目",
      "consumers": ["rag_kb", "similarity_search_tool"]
    }
  },
  "generation_strategy_enum": {
    "generate": "在基线模式下从头生成该文件",
    "regenerate": "在增量模式下完全重新生成该文件",
    "conditional_regenerate": "在增量模式下满足条件时重新生成，否则复用旧文件",
    "reuse": "在增量模式下直接复用基线生成的旧文件",
    "incremental_update": "在增量模式下仅更新变更部分，保留未变更内容",
    "skip": "在当前模式下不生成该文件"
  }
}
